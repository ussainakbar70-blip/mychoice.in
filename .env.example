# ==============================================================================
# MYCHOICE.in - Environment Configuration Template
# Copy this file to .env.local for local development. Never commit .env.local!
# ==============================================================================

# Site URLs & Canonical Configuration
NEXT_PUBLIC_SITE_URL=https://mychoice.in
NEXT_PUBLIC_SITE_NAME=MYCHOICE.in
SITE_INDEXING_ENABLED=false
APP_BASE_URL=https://mychoice.in

# Supabase Authentication & PostgreSQL Database
# Retrieve these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# CJdropshipping Open API v2.0 Configuration
# Obtain credentials from: https://cjdropshipping.com -> My CJ -> Authorization -> API
CJ_API_BASE_URL=https://developers.cjdropshipping.com/api2.0
CJ_API_KEY=
CJ_CLIENT_ID=
CJ_CLIENT_SECRET=
CJ_ACCESS_TOKEN=
CJ_REFRESH_TOKEN=
CJ_OPEN_ID=
CJ_WEBHOOK_SECRET=

# Commerce & Currencies
# Default store currency: INR, USD, EUR, GBP, AED
DEFAULT_CURRENCY=INR
PAYMENT_CURRENCY=INR
MINIMUM_MARGIN_PERCENT=35

# Payment Gateway Configuration
# Provider: cashfree | razorpay | mock
PAYMENT_PROVIDER=cashfree
# Mode: test | sandbox | live | production
PAYMENT_MODE=test

# Cashfree Payment Gateway (PG v2023-08-01 API)
# Test credentials obtained from Cashfree Dashboard -> Developers -> API Keys (Sandbox)
# App / Client ID (Public client identifier)
NEXT_PUBLIC_CASHFREE_APP_ID=
CASHFREE_APP_ID=
# Server-only Secret Key (Never expose to client)
CASHFREE_SECRET_KEY=
# Cashfree Webhook Secret (or defaults to CASHFREE_SECRET_KEY)
CASHFREE_WEBHOOK_SECRET=
# API Version (defaults to 2023-08-01)
CASHFREE_API_VERSION=2023-08-01

# Secondary / Legacy Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# Transactional Email & Notifications
EMAIL_PROVIDER=development
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="MYCHOICE.in <orders@mychoice.in>"
ADMIN_EMAIL=admin@mychoice.in

# Analytics & Monitoring
ANALYTICS_ID=
