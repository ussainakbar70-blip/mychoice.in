# ==============================================================================
# MYCHOICE.in - Environment Configuration Template
# Copy this file to .env.local for local development. Never commit .env.local!
# ==============================================================================

# Site URLs & Canonical Configuration
NEXT_PUBLIC_SITE_URL=https://mychoice.in
NEXT_PUBLIC_SITE_NAME=MYCHOICE.in
SITE_INDEXING_ENABLED=false

# Supabase Authentication & PostgreSQL Database
# Retrieve these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# CJdropshipping Open API v2.0 Configuration
# Obtain credentials from: https://cjdropshipping.com -> My CJ -> Authorization -> API
CJ_API_BASE_URL=https://developers.cjdropshipping.com/api2.0
CJ_API_KEY=
CJ_CLIENT_ID=
CJ_CLIENT_SECRET=
CJ_ACCESS_TOKEN=
CJ_REFRESH_TOKEN=
CJ_WEBHOOK_SECRET=

# Commerce & Currencies
# Default store currency: USD, INR, EUR, GBP, AED
DEFAULT_CURRENCY=USD
MINIMUM_MARGIN_PERCENT=35

# Payment Gateway Configuration (Defaults to 'development' mock provider)
PAYMENT_PROVIDER=development
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Transactional Email & Notifications
EMAIL_PROVIDER=development
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="MYCHOICE.in <orders@mychoice.in>"
ADMIN_EMAIL=admin@mychoice.in

# Analytics & Monitoring
ANALYTICS_ID=
